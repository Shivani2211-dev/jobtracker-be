# Copy to .env for local development. Never put real secrets in this file.

# Local development defaults to SQLite; production sets a Postgres URL.
DATABASE_URL=sqlite:///./jobtracker.db

# "development" or "production". Production refuses to start without a
# real SECRET_KEY.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret

# Frontend origin(s) allowed to call the API, comma-separated.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: real AI analysis. Without a key the app uses a local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: enables the shared demo account (python -m scripts.seed_demo).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
